//// Material icons (ADR 0044, 0047), drawn inline as SVG so they need no icon font and work offline. The paths are
//// Google's Material Icons (Apache 2.0), on a 24-unit grid. Icons are decorative: the text next to them, or the
//// `aria-label` of their button, names what they do.

import lustre/attribute
import lustre/element.{type Element}
import lustre/element/svg

pub type Icon {
  Today
  EventNote
  DirectionsRun
  Group
  Settings
  Add
  Close
  Check
}

pub fn view(icon: Icon) -> Element(msg) {
  svg.svg(
    [
      attribute.class("icon"),
      attribute.attribute("viewBox", "0 0 24 24"),
      attribute.attribute("aria-hidden", "true"),
      attribute.attribute("focusable", "false"),
    ],
    [svg.path([attribute.attribute("d", path(icon))])],
  )
}

