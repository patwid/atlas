//// Fluent System Icons (ADR 0133), drawn inline as SVG so they need no icon font and work offline. The paths are
//// Microsoft's Fluent UI System Icons (MIT), copied from the `@fluentui/svg-icons` package (1.1.344), at their 24px
//// size. `view` draws the regular style; `filled` draws the filled style, for a selected navigation item. Icons are
//// decorative: the text next to them, or the `aria-label` of their button, names what they do. The constructors keep
//// the names of the Material icons they replaced (ADR 0044).

import gleam/list
import lustre/attribute
import lustre/element.{type Element}
import lustre/element/svg

pub type Icon {
  Home
  EventNote
  DirectionsRun
  Group
  Settings
  Add
  Close
  Check
  ArrowBack
  Pending
  ChevronRight
  AccountCircle
  Favorite
  Link
  CloudOff
  CloudUpload
  ErrorOutline
  Edit
  Delete
  ContentCopy
  Lock
  Inbox
  SearchOff
  EditNote
  CalendarToday
  Schedule
  ChevronLeft
  MoreVert
  PersonAdd
  Search
  UploadFile
  Flag
  Watch
}

pub type Style {
  Regular
  Filled
}

pub fn view(icon: Icon) -> Element(msg) {
  draw(paths(icon, Regular))
}

pub fn filled(icon: Icon) -> Element(msg) {
  draw(paths(icon, Filled))
}

fn draw(ds: List(String)) -> Element(msg) {
  svg.svg(
    [
      attribute.class("icon"),
      attribute.attribute("viewBox", "0 0 24 24"),
      attribute.attribute("aria-hidden", "true"),
      attribute.attribute("focusable", "false"),
    ],
    list.map(ds, fn(d) { svg.path([attribute.attribute("d", d)]) }),
  )
}

