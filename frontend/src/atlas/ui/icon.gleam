//// Material icons (ADR 0044, 0047, 0049), drawn inline as SVG so they need no icon font and work offline. The paths
//// are Google's Material Icons, filled style (Apache 2.0), copied from the `@material-design-icons/svg` package
//// (0.14.15), on a 24-unit grid. Icons are decorative: the text next to them, or the `aria-label` of their button,
//// names what they do.

import gleam/list
import lustre/attribute
import lustre/element.{type Element}
import lustre/element/svg

pub type Icon {
  Today
