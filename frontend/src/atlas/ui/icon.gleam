//// Material icons (ADR 0044, 0047, 0049, 0055), drawn inline as SVG so they need no icon font and work offline. The
//// paths are Google's Material Icons (Apache 2.0), copied from the `@material-design-icons/svg` package (0.14.15),
//// on a 24-unit grid. `view` draws the outlined style, Material 3's default; `filled` draws the filled style, for a
//// selected navigation item. Icons are decorative: the text next to them, or the `aria-label` of their button,
//// names what they do.

import gleam/list
import lustre/attribute
import lustre/element.{type Element}
import lustre/element/svg

pub type Icon {
  Today
  EventNote
  DirectionsRun
  Group
  Settings
  Add
  Close
  Check
  ArrowBack
  Pending
  ChevronRight
  AccountCircle
  Sync
  Favorite
  Link
  CloudOff
  CloudUpload
  ErrorOutline
  Edit
  Delete
  Share
  ContentCopy
  Lock
  Public
  Inbox
  SearchOff
  EditNote
  CalendarToday
  Schedule
  ChevronLeft
  MoreVert
  PersonAdd
  PlayArrow
}

pub type Style {
  Outlined
  Filled
}

pub fn view(icon: Icon) -> Element(msg) {
  draw(paths(icon, Outlined))
}

pub fn filled(icon: Icon) -> Element(msg) {
  draw(paths(icon, Filled))
}

fn draw(ds: List(String)) -> Element(msg) {
  svg.svg(
    [
      attribute.class("icon"),
      attribute.attribute("viewBox", "0 0 24 24"),
      attribute.attribute("aria-hidden", "true"),
      attribute.attribute("focusable", "false"),
    ],
    list.map(ds, fn(d) { svg.path([attribute.attribute("d", d)]) }),
  )
}

